# 제주데이터허브 프로젝트키 (마이페이지 → 프로젝트 관리 → 프로젝트 상세)
# 제출물에 포함 금지: 매뉴얼에는 발급 방법만 적는다
HUB_PROJECT_KEY=

# 외부 LLM API: Claude Haiku 5.5 (Anthropic Messages API, SDK 없이 표준 라이브러리로 호출)
# 평가용 키는 사용 한도를 설정하고 평가 종료 후 폐기
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-haiku-5-5
# (참고) 개발 중 쓴 OpenAI 호환 API — 제출·평가용으로 쓰지 않는다
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.exaone.ai/v1
#   LLM_MODEL=k-exaone_v2.5
#   LLM_JSON_MODE=prompt
#   LLM_EXTRA_BODY={"reasoning_effort": "low"}
#   LLM_TIMEOUT_S=60

# 공공데이터포털 서비스키 (링크형 데이터를 쓸 때만)
DATA_GO_KR_KEY=
