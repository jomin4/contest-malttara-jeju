# 제주데이터허브 프로젝트키 (마이페이지 → 프로젝트 관리 → 프로젝트 상세)
# 제출물에 포함 금지: 매뉴얼에는 발급 방법만 적는다
HUB_PROJECT_KEY=

# 외부 LLM API (주제·설계 확정 후 사용 모델에 맞게 수정)
# 평가용 키는 사용 한도를 설정하고 평가 종료 후 폐기
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 개발: K-EXAONE 2.5 무료 API (docs.exaone.ai) — 제출·평가용으로 쓰지 않는다
#   LLM_BASE_URL=https://api.exaone.ai/v1
#   LLM_MODEL=k-exaone_v2.5
#   LLM_JSON_MODE=prompt
#   LLM_EXTRA_BODY={"reasoning_effort": "low"}
# 배포: Upstage Solar Pro 4 유료 API
#   LLM_BASE_URL=https://api.upstage.ai/v1
#   LLM_MODEL=solar-pro4
#   LLM_JSON_MODE=schema

# 공공데이터포털 서비스키 (링크형 데이터를 쓸 때만)
DATA_GO_KR_KEY=
