# secrets
.env
.env.*
!.env.example

# data: 원본·DB는 커밋하지 않음 (data/catalog, data/cards는 커밋)
data/raw/*
!data/raw/.gitkeep
data/db/*
!data/db/.gitkeep
*.sqlite
*.sqlite3
*.db

# 대회 제공 파일 (외부 배포 금지)
*데이터목록*.xlsx
*예시데이터*.xlsx

# 제출 산출물
submission/*
!submission/.gitkeep

# python / node / OS
__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
build/
.DS_Store
Thumbs.db
.idea/
